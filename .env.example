GENERATOR_API_PORT=8001
PIPELINE_API_PORT=8002
RAG_API_PORT=8003

# MinIO / Bronze
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=bronze
MINIO_JSON_PREFIX=raw
MINIO_PDF_PREFIX=raw/pdf
MINIO_SECURE=false

# PostgreSQL / Gold textual
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=usp_data_lake
POSTGRES_USER=usp
POSTGRES_PASSWORD=usp123

# Qdrant / Gold vetorial
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=usp_news_embeddings

# Embeddings locais
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=
HF_CACHE_HOST=C:/Users/SEU_USUARIO/.cache/huggingface

# Ollama local (use host.docker.internal no container)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_TIMEOUT=300
OLLAMA_TEMPERATURE=0.1
OLLAMA_NUM_PREDICT=96
OLLAMA_NUM_CTX=2048
OLLAMA_KEEP_ALIVE=10m

# Contexto RAG
RAG_MAX_CONTEXT_CHARS=6000
RAG_MAX_SOURCES=3

# Busca híbrida
RAG_HYBRID_ENABLED=true
RAG_LEXICAL_ENABLED=true
RAG_INITIAL_CANDIDATES=20
RAG_FINAL_SOURCES=5
RAG_MAX_CHUNKS_PER_SOURCE=1
RAG_VECTOR_WEIGHT=1.0
RAG_LEXICAL_WEIGHT=2.0
RAG_RRF_K=60
RAG_LEXICAL_TITLE_WEIGHT=3.0
RAG_LEXICAL_CATEGORY_WEIGHT=1.5
RAG_LEXICAL_CONTENT_WEIGHT=1.0
RAG_LEXICAL_AUTHOR_WEIGHT=0.5
RAG_BM25_K1=1.5
RAG_BM25_B=0.75

# Avaliação de evidências e recusa segura
RAG_EVIDENCE_CHECK_ENABLED=true
RAG_MIN_DIRECT_SOURCES=1
RAG_MIN_TOTAL_RELEVANT_SOURCES=2
RAG_MIN_QUERY_TERM_COVERAGE=0.60
RAG_MIN_LEXICAL_MATCHED_SOURCES=1
RAG_ALLOW_SINGLE_STRONG_SOURCE=true
RAG_SINGLE_STRONG_SOURCE_MIN_COVERAGE=0.80
RAG_SINGLE_STRONG_SOURCE_REQUIRE_TITLE_MATCH=false
RAG_SINGLE_STRONG_SOURCE_MIN_MATCHED_TERMS=2
RAG_SINGLE_STRONG_SOURCE_MAX_LEXICAL_RANK=3
RAG_SINGLE_STRONG_SOURCE_ALLOW_STRONG_PARTIAL=true
RAG_REJECT_ALL_WEAK=true
